{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Forum": "Data Source=forum.db"
  },
  "Jwt": {
    "Issuer": "forum-api",
    "Audience": "forum-client",
    "Key": "development-only-signing-key-replace-before-any-real-deployment",
    "LifetimeMinutes": 60
  },
  "RateLimiting": {
    "CredentialAttemptsPerMinute": 10
  }
}
